# Chaîne de connexion Postgres (Neon, ou toute base Postgres).
# En local : copiez ce fichier en .env.local et remplissez la valeur.
# En production (Render) : ajoutez la même variable dans Settings > Environment.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret utilisé pour signer les sessions de connexion des restaurateurs.
# Obligatoire. Générez une valeur aléatoire, par exemple :
#   openssl rand -base64 32
SESSION_SECRET=

# Envoi des emails de réinitialisation de mot de passe (Resend).
# Sans RESEND_API_KEY, la demande de réinitialisation échoue silencieusement
# côté visiteur et l'erreur est tracée dans les logs du serveur.
RESEND_API_KEY=
# Expéditeur des emails. onboarding@resend.dev fonctionne sans vérifier de
# domaine ; mettez une adresse de votre domaine une fois celui-ci vérifié.
EMAIL_FROM=onboarding@resend.dev

# Paiement en ligne (Stripe Connect). Sans STRIPE_SECRET_KEY, les clients
# commandent et paient en salle comme avant.
# Clé secrète du compte Stripe de la plateforme (sk_test_... pour tester,
# sk_live_... en production) : Stripe > Développeurs > Clés API.
STRIPE_SECRET_KEY=
# Deux endpoints Stripe, la même URL https://wegood.kim/api/stripe/webhook.
# L'ancienne URL https://order-restaurant-1.onrender.com/api/stripe/webhook
# continue de répondre : ne pas la couper dans Stripe avant d'avoir basculé
# les deux endpoints.
# Un endpoint n'écoute qu'une origine : « Comptes connectés » (connect: true)
# OU « Votre compte » (connect: false), jamais les deux. Chacun a son secret.
#
# Endpoint déjà en place, comptes connectés. Événements : checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded, account.updated.
STRIPE_WEBHOOK_SECRET=
# Second endpoint, événements du compte plateforme (abonnement). Même URL,
# origine « Votre compte ». Événements : customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed, checkout.session.completed,
# checkout.session.async_payment_succeeded.
# Optionnel tant que l'abonnement n'est pas activé. Ne pas y recopier le secret
# de l'endpoint Connect.
STRIPE_WEBHOOK_SECRET_PLATFORM=

# Abonnement des restaurants (Stripe Billing sur le compte plateforme, pas
# sur les comptes connectés). Price récurrent mensuel en EUR, du montant de
# PAID_PLAN dans src/lib/plans.ts (29 EUR). Produit créé à la main dans le
# tableau de bord Stripe ; l'essai de 14 jours est ajouté par l'application.
# Sans cette variable, la page Abonnement ne propose pas de paiement.
STRIPE_PRICE_ID=

# Exigence d'abonnement. Défaut : activée (variable absente, vide, ou true).
# L'essai de 14 jours commence à l'inscription. Ensuite, les nouvelles
# commandes sont refusées sans abonnement actif. Un prélèvement en échec
# (past_due) laisse 7 jours de grâce. unpaid, canceled et incomplete_expired
# ferment les commandes. Les données, le menu et les réglages restent en base.
# Mettre false, 0, off ou non pour rouvrir l'accès sans abonnement (dépannage).
# Sur Render : rien à changer si la variable est absente. Si elle vaut false,
# la retirer ou la passer à true, sinon le paywall ne s'applique pas.
# La fonction qui la lit est isBillingEnforced() dans src/lib/access.ts.
BILLING_ENFORCED=

# Accès administrateur de la plateforme (/plateforme), en lecture seule sur
# tous les restaurants. Sans ces deux variables, l'accès est fermé.
# Emails autorisés, séparés par des virgules.
PLATFORM_ADMIN_EMAILS=
# Mot de passe de cet accès, 13 caractères minimum. Le changer déconnecte
# immédiatement toutes les sessions ouvertes. Exemple : openssl rand -base64 24
PLATFORM_ADMIN_PASSWORD=

# Mesure d'audience Umami (sans cookies), sur les pages publiques uniquement.
# Identifiant du site, visible dans Umami > Paramètres > Sites (data-website-id).
# Sans valeur, aucun script de mesure n'est chargé.
UMAMI_WEBSITE_ID=

# Adresse publique du site : canonique, Open Graph, QR codes, liens d'email,
# URLs de retour Stripe (Checkout, portail, Connect).
# Optionnel. En production, le défaut du code est https://wegood.kim.
# En local, sans cette variable, l'adresse est déduite de la requête.
# NEXT_PUBLIC_* est figé au build : sur Render, modifier la valeur puis
# redéployer, sinon l'ancien contenu du build reste en place.
# La seule variable lue pour cela est NEXT_PUBLIC_BASE_URL.
# Sur Render : https://wegood.kim
# En local : laisser vide.
NEXT_PUBLIC_BASE_URL=
