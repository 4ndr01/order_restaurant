# Chaîne de connexion Postgres (Neon, ou toute base Postgres).
# En local : copiez ce fichier en .env.local et remplissez la valeur.
# En production (Render) : ajoutez la même variable dans Settings > Environment.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret utilisé pour signer les sessions de connexion des restaurateurs.
# Obligatoire. Générez une valeur aléatoire, par exemple :
#   openssl rand -base64 32
SESSION_SECRET=

# Envoi des emails de réinitialisation de mot de passe (Resend).
# Sans RESEND_API_KEY, la demande de réinitialisation échoue silencieusement
# côté visiteur et l'erreur est tracée dans les logs du serveur.
RESEND_API_KEY=
# Expéditeur des emails. onboarding@resend.dev fonctionne sans vérifier de
# domaine ; mettez une adresse de votre domaine une fois celui-ci vérifié.
EMAIL_FROM=onboarding@resend.dev

# Adresse publique du site, utilisée pour générer les QR codes des tables.
# Optionnel : sans elle, l'adresse est déduite de la requête entrante.
NEXT_PUBLIC_BASE_URL=
